  "features": [
    {
      "name": "原版上下对置构图",
      "description": "保留原机上下线圈段夹持中部空心腔的辨识特征，上端为热萃取夹套，下端为棱面凝固腔。"
    },
    {
      "name": "通透相界腔",
      "description": "成对铱制肋条围合膨大的中空转换区，内部四片错叠相界叶片保留中央孔隙，上下喷嘴在孔隙外相向布置。"
    },
    {
      "name": "冷热端差异",
      "description": "上端外露连续螺旋加热线圈和分段热屏，下端采用分瓣蓝色冷凝外壳、贴体回流肋和收束成型端，避免上下简单复制。"
    },
    {
      "name": "双侧错位反力架",
      "description": "两条前后错位的C形反力架连接上下机头，带内轨、斜腹杆和局部接头，取代原有落地薄框架。"
    },
    {
      "name": "后置板束回热器",
      "description": "独立鳍片、双集管和两个循环泵组成紧凑的后部回热模块，多条闭合管路分别接入热端与凝固端。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
