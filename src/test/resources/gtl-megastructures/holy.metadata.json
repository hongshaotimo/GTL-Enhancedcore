  "features": [
    {
      "name": "银白离析冠",
      "description": "一组开底冠环围绕透明工作腔，白色铱壳、深色结构芯与蓝色场发生节点表现神圣而精密的机器气质。"
    },
    {
      "name": "三对机械刃翼",
      "description": "三组不同角度、长度和前后深度的机械导向板向两侧展开，镂空槽、场导轨、夹持轴承和背部支架共同构成实体机械组件。"
    },
    {
      "name": "可见分离机构",
      "description": "透明棱面腔内设置贯穿主轴、上下夹头和错层刀盘，表达原机的切削、车削、粉碎及离心处理设定。"
    },
    {
      "name": "背部双驱动匣",
      "description": "两个带独立轴承端、散热槽和动力接头的棱面驱动匣延伸到腔体后方，连接主轴、冠环和刃翼根部。"
    },
    {
      "name": "分叉收集回路",
      "description": "工作腔下方的双股分离通道向两侧分出，再收拢进入锥形收集端，与冠环回路相接。"
    },
    {
      "name": "分瓣镂空机械冠",
      "description": "四片前后错层的银白冠瓣围合细长菱形玻璃晶核，蓝色场导线嵌入冠瓣内缘；顶部渐细分叉，保留中央和两肩的通透空间。"
    },
    {
      "name": "悬空双尖构图",
      "description": "上端为轻盈开放的机械冠，下端为窄收集尾部，整体悬空，无落地底座、楼梯或人员平台。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。局部内凹嵌入原有壳体，保留外缘轮廓。"
    }
  ],
