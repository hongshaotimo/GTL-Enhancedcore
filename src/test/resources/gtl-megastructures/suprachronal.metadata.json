  "features": [
    {
      "name": "轴向时序装配阵列",
      "description": "三道主约束环、四道较小校准环和七组径向工具站围绕一条连续装配轴布置。"
    },
    {
      "name": "中部维度桥接腔",
      "description": "相反方向的螺旋桥接带与倾斜相位弧交织，连接各工具站与主环。"
    },
    {
      "name": "小尺度机构细节",
      "description": "工具头、相位卡匣、磁轨接头和冷却梳均由1至4格构件组成，避免大面积平板和房间式模块。"
    },
    {
      "name": "空中环列",
      "description": "取消落地底座、楼梯、走道和操作平台，环列通过自身导轨与径向构件连接。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。局部内凹嵌入原有壳体，保留外缘轮廓。"
    }
  ],
