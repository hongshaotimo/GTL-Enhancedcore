  "features": [
    {
      "name": "四辊主轧架",
      "description": "一座带斜肩开窗铸造侧架的四辊轧机作为主体，上下支承辊、细工作辊、轴承滑座、拉杆与压下机构清晰分层。"
    },
    {
      "name": "预热与精整",
      "description": "短预热喉口保留原机白铜加热线圈；四股线材贯穿轧缝后进入低矮的独立精整模盒，形成有起伏的加工轮廓。"
    },
    {
      "name": "双卷筒收线",
      "description": "尾部两个大直径收线卷筒并排布置，镂空辐条端盘、分区绕组、排线导杆和落地轴承鞍座表达线材产出。"
    },
    {
      "name": "承重铸造底座",
      "description": "连续箱形纵梁在主轧架处拓宽，在收线端分叉；回流槽、凹入传动沟与短加强肋参与实际承重，不铺空白大底板。"
    },
    {
      "name": "不对称传动",
      "description": "左侧独立电机与双联齿轮传动接入辊轴，右侧为较轻的散热回流组件，打破整条机器等宽重复的形态。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
