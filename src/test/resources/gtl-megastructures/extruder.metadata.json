  "features": [
    {
      "name": "四臂悬空约束架",
      "description": "四条带内凹蓝色场导轨的铱制反力臂，从供料端外张，再收拢夹持压模端；内肋与斜腹杆形成有深度的开放约束骨架。"
    },
    {
      "name": "对向力场合模",
      "description": "四组带观察槽的场发生匣驱动上下六块独立压制靴，中间保留透明观察腔，表现压缩与挤压成型两种原机功能。"
    },
    {
      "name": "三路定型出口",
      "description": "浅而宽的模架设置圆管、矩形材和工字截面三个模口，后接悬臂校准盒与可见型材，明确区分入口和成型出口。"
    },
    {
      "name": "分层工艺细节",
      "description": "供料推进杆、场芯、内侧发射面、压靴接缝、斜向拉结、模架锁块与出口导向件分别服务于加工和约束关系。"
    },
    {
      "name": "无底座悬浮结构",
      "description": "供料座、反力臂、场发生匣、合模组件和定型端组成完整悬空设备，下方保持开放，不设置底板或人员平台。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
