  "features": [
    {
      "name": "收腰冷却塔",
      "description": "保留原版冰蓝塔壳、下部进气和收腰敞口，拉高比例；壳体有曲线加强筋、窄观察缝与内凹散热窗。"
    },
    {
      "name": "开放进气带",
      "description": "下部八组进气百叶具有真实间隙，每组配有小型执行机构，透过进气带可见内部换热层。"
    },
    {
      "name": "分层换热芯",
      "description": "五组径向散热片围绕冷却分配柱布置，四根回流立管、上部分配环与折流片构成连续设备关系。"
    },
    {
      "name": "敞口排气冠",
      "description": "顶部敞开并略向外展开，内置后掠风叶、固定电机支架和十二片短导流板。"
    },
    {
      "name": "悬挂回流系统",
      "description": "底部以八条倾斜回流管连接环形集液管汇和小型密闭接收器，保留管路之间的空隙，无落地底盘。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
