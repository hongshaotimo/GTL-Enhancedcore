  "features": [
    {
      "name": "母晶胞与八个子晶胞",
      "description": "中央菱形十二面体透明腔体包容主种晶与分子晶格，八个八面体子晶胞沿体对角线重复展开。"
    },
    {
      "name": "棱线约束晶架",
      "description": "赤色三钛约束架按菱形十二面体的二十四条棱布置，配对分子导轨、调节鞍和棱角接头保留大量通透空间。"
    },
    {
      "name": "嵌套分子晶格",
      "description": "中央种晶、内层晶格和子晶胞由连续供液与分子输运构件相接，以多尺度重复表达无限晶胞。"
    },
    {
      "name": "原设定用材与核心",
      "description": "沿用原机的透明腔体、分子线圈、三钛外壳与单个超能核心，保留结晶、浸洗与洗矿的设备表达。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
