  "features": [
    {
      "name": "斜肩闭式主压架",
      "description": "高大的斜肩侧架夹持单一主压缸，张紧杆、导轨、移动模座和固定砧座清晰外露，表达锻锤与成型压制。"
    },
    {
      "name": "独立折弯附件",
      "description": "右前方较小的折弯头带V形下模和楔形上模，通过横移导轨接入主滑台，形成不同尺度的加工层次。"
    },
    {
      "name": "承重一体底座",
      "description": "连续落地铸床在压架下加厚，前方仅伸出承载模具滑台的短纵梁，侧部承托折弯头与传动，尾部不留空平台。"
    },
    {
      "name": "滑台与传动细节",
      "description": "双燕尾导轨、模具抽匣、内凹回流槽、左侧轴向驱动与后部可观察动力匣围绕实际机构布置。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
