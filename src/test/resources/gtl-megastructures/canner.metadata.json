  "features": [
    {
      "name": "错位双转盘",
      "description": "十二工位大灌装转盘与六工位小封罐转盘错位相接，环形分配头、深压盖头和转移吊轨分别形成清晰工序。"
    },
    {
      "name": "吊挂容器阵列",
      "description": "容器由颈部夹具承托，透明罐身内可见不同装填状态；计量嘴和压盖头直接落向罐口，下方没有底板。"
    },
    {
      "name": "横置供料罐",
      "description": "上部横向供料罐带收束端盖、观察槽和计量管路，通过短鞍架连接灌装分配头，成为横向主体的上部重心。"
    },
    {
      "name": "独立罐盖仓",
      "description": "小转盘后方的透明罐盖仓显示层叠盖坯，狭窄送盖槽接入封罐分配头，与供料罐采用不同轮廓。"
    },
    {
      "name": "悬浮工艺骨架",
      "description": "偏置上部桥架承接大小转盘和悬吊输送轨；局部竖向护罩、齿环和夹具服务于运转，整体无底座、楼梯和人员平台。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
