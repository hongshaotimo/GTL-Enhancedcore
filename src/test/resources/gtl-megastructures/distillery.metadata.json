  "features": [
    {
      "name": "高瘦主分馏塔",
      "description": "主塔由较宽的下部提馏段过渡到细长精馏段，内置六层分离塔盘，顶部采用封闭压力头与主汽桥。"
    },
    {
      "name": "再沸热区",
      "description": "左下方小型再沸器使用三组原机三钛线圈，配有隔热护板、承托鞍座、独立液体回路和蒸汽回塔管。"
    },
    {
      "name": "冷凝回流侧脊",
      "description": "右侧折板冷凝器、低位回流罐与独立上升回流管构成紧凑回路，冷凝器骨架直接落在设备基础上。"
    },
    {
      "name": "分区落地底座",
      "description": "主塔环形承重裙座、再沸器机座和回流设备基础按设备轮廓分区，锚固肋、管槽及低位横梁形成连续承重与管路空间。"
    },
    {
      "name": "原机材质延续",
      "description": "仅使用原机已核对的洁净外壳、水密外壳、UEV气密外壳和三钛线圈，以银白主塔、青黑管汇、绿色密封区和局部暗红加热区区分功能。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
