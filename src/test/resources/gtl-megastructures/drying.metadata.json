  "features": [
    {
      "name": "立式热真空炉",
      "description": "以批次装料、分区加热、低压排湿重新组织机器，立式封闭炉腔带后倾装料面和五层料架。"
    },
    {
      "name": "双扇压紧炉门",
      "description": "棱面双门、连续红钢密封边和三层独立压紧机构构成正面主体，强化真空炉的密封与锁闭特征。"
    },
    {
      "name": "嵌入式加热夹层",
      "description": "侧壁三段铜镍加热区收在浅色隔热护板内，通过内凹窗口可见线圈与接线端。"
    },
    {
      "name": "收拢式承力框",
      "description": "前后两组不同斜率的承力构件向炉顶收拢，并直接落在两侧机脚上，顶压盖与炉体形成紧凑整体。"
    },
    {
      "name": "背部抽空冷凝脊",
      "description": "双级方形真空组件、侧面冷凝片、抽气管和底部集液器全部整合进背部设备脊。"
    },
    {
      "name": "一体落地机座",
      "description": "两侧中空承重脚、中央设备龙骨和三根横梁形成有留空的底座，管槽、检修格栅和排液阀贴合机器布局。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
