  "features": [
    {
      "name": "六向共同焦点",
      "description": "保留原版三轴六向注入结构，六条光学通道汇入同一个透明多面蚀刻腔。"
    },
    {
      "name": "分段光学臂",
      "description": "每条注入臂包含锥形物镜、分层透镜、五组线圈包、调焦叉和维度注入端，避免整块长箱体。"
    },
    {
      "name": "交错校准弧",
      "description": "三种半径的四分之一校准轨连接各臂，弧上有小型定位头与通向中央的透明校准光路。"
    },
    {
      "name": "飞行接近",
      "description": "取消地面底座、楼梯及人员平台；所有接口按空中接近保留空间。"
    },
    {
      "name": "内嵌5×5集中接口",
      "description": "中央为主方块，周围24个仓室连续排列，全部共面并贴合机身。"
    }
  ],
